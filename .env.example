# ============================================
# Medical Device Discovery - Environment Config
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --------------------------------------------
# REQUIRED: Your OpenAI API key for AI assistant
# Get one at: https://platform.openai.com/api-keys
# --------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# OPTIONAL: Custom API base URL
# Use this for Azure OpenAI or other compatible APIs
# Default: https://api.openai.com/v1
# 
# Azure example: https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# Local LLM example: http://localhost:1234/v1
# --------------------------------------------
OPENAI_API_BASE=https://api.openai.com/v1

# --------------------------------------------
# OPTIONAL: Model to use
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Default: gpt-4o-mini (fast and cheap)
# --------------------------------------------
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------
# REQUIRED for Docker: Your computer's local IP address
# This is needed so QR codes contain the correct URL
# that your phone can reach on the local network.
#
# Find your IP:
#   Mac/Linux: ifconfig | grep "inet " | grep -v 127.0.0.1
#   Windows:   ipconfig (look for IPv4 Address)
#
# Example: 192.168.1.100
# --------------------------------------------
HOST_IP=your_local_ip_here

# --------------------------------------------
# REQUIRED for SMART App Launch: Flask secret key for sessions
# The OAuth2 state / PKCE verifier / access token live in the signed session
# cookie across the authorize redirect, so this must be set and stable.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# --------------------------------------------
SECRET_KEY=change-this-to-a-random-secret-key

# --------------------------------------------
# OPTIONAL: Environment mode
# Options: development, production
# --------------------------------------------
FLASK_ENV=production

# --------------------------------------------
# SMART App Launch v2 (services/gudid-core/smart_launch.py)
# Public client + PKCE, no secret. Defaults target the SMART Health IT sandbox.
#
# APP_BASE_URL       Public URL of THIS app; the OAuth redirect_uri is
#                    <APP_BASE_URL>/smart/callback. Register that exact URL as
#                    the app's Redirect URL in the SMART launcher.
# SMART_CLIENT_ID    Client id sent to the auth server (sandbox accepts any).
# SMART_DEFAULT_ISS  FHIR base used for a standalone launch (/launch/standalone).
# --------------------------------------------
APP_BASE_URL=http://localhost:8090
SMART_CLIENT_ID=periop-udi
SMART_DEFAULT_ISS=https://launch.smarthealthit.org/v/r4/fhir
